    and SLH-DSA key generation (n = 20) and signing (n = 10).],
  tsmall(table(
    columns: (auto, auto, auto, auto),
    align: (left, right, right, right),
    table.hline(stroke: 0.6pt),
    table.header([*Suite / component*], [*KeyGen*], [*Sign*], [*Verify*]),
    table.hline(stroke: 0.4pt),
    ..("VYRA-SIG-2", "VYRA-SIG-3", "VYRA-SIG-5", "VYRA-SIG-PQ1", "VYRA-SIG-PQ3", "VYRA-SIG-PQ5").map(s => (
      s, us-to-ms(med("sig-suite", s, "keygen")), us-to-ms(med("sig-suite", s, "sign-1KiB")),
      us-to-ms(med("sig-suite", s, "verify-1KiB")),
